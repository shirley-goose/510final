# Pet2Companion — copy to `.env.local` locally. For production, set the same keys in
# your host (e.g. Vercel → Project → Settings → Environment Variables), never in git.

# --- Supabase (project Settings → API) ---
# URL + anon key are safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: server-only. Never prefix with NEXT_PUBLIC or ship to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional bucket overrides (defaults: pet-uploads / companion-models)
SUPABASE_STORAGE_BUCKET=pet-uploads
COMPANION_MODEL_STORAGE_BUCKET=companion-models

# --- AI 3D generation: 3daistudio (default) or meshy ---
AI_3D_PROVIDER=3daistudio
MESHY_API_KEY=

# 3D AI Studio (when AI_3D_PROVIDER unset or 3daistudio)
# Create keys at https://www.3daistudio.com/Platform/API#api-keys
THREED_AI_STUDIO_API_KEY=
# Optional overrides
THREED_AI_STUDIO_API_BASE_URL=
# Model version suffix: 3.0, 3.1, or leave empty for provider default (3.0)
THREED_AI_STUDIO_MODEL_VERSION=

# --- Companion overlay UX ---
NEXT_PUBLIC_DEFAULT_COMPANION_CORNER=br

# --- Production checklist (not env vars; configure in dashboards) ---
# Supabase → Authentication → URL configuration:
#   Site URL = your production origin (e.g. https://your-app.vercel.app)
#   Redirect URLs: include https://your-app.vercel.app/reset and wildcard or path as needed
