# Pet2Companion — copy to `.env.local` and fill in values locally.
# This file is safe to commit; never commit `.env.local` with real secrets.

# Supabase (public + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional bucket overrides (defaults: pet-uploads / companion-models)
SUPABASE_STORAGE_BUCKET=pet-uploads
COMPANION_MODEL_STORAGE_BUCKET=companion-models

# AI 3D generation: tripo (default) or meshy
AI_3D_PROVIDER=tripo
MESHY_API_KEY=

# Tripo3D (when AI_3D_PROVIDER unset or tripo)
TRIPO_API_KEY=
# Optional Tripo overrides
TRIPO_REGION=
TRIPO_API_BASE_URL=
TRIPO_MODEL_VERSION=

# Companion overlay UX
NEXT_PUBLIC_DEFAULT_COMPANION_CORNER=br
